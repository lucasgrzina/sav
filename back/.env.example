APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# --- WebSockets / Reverb ---
# BROADCAST_CONNECTION=reverb

# REVERB_APP_ID=sav_app_id
# REVERB_APP_KEY=sav_app_key
# REVERB_APP_SECRET=sav_app_secret
# REVERB_HOST=0.0.0.0
# REVERB_PORT=8080
# REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
AUTH_INVITATION_LINK_EXPIRATION_HOURS=72

SANCTUM_ACCESS_TOKEN_EXPIRATION=1440
# En producción, sobreescribir con el dominio real del frontend:
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173

# WhatsApp gateway for Channel::Whatsapp. Available: twilio | kapso | fake
# `fake` is the default for local development: it satisfies the whole delivery pipeline
# without credentials and without sending real messages. Switch to twilio/kapso only when
# working on the channel itself, and fill in the matching credentials below.
WHATSAPP_PROVIDER=fake

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TEMPLATE_MESSAGE_SERVICE=
TWILIO_TEMPLATE_PROGRAM_CREATED=
TWILIO_TEMPLATE_PROGRAM_CANCELLED=
# Pending business approval — the legacy 5-message-bundle catalog no longer applies:
TWILIO_TEMPLATE_PROGRAM_TASK_DUE=
# Optional override for local tunnels: when empty, resolved from route('webhooks.twilio').
# TWILIO_STATUS_CALLBACK_URL=https://xxxx.trycloudflare.com/api/v1/webhooks/twilio

# Kapso (Meta WhatsApp Cloud API proxy). Template names default to the sav_* set below,
# so they only need overriding when the Kapso project uses a different naming.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Only need uncommenting if you want to deviate from the default shown here.
# KAPSO_BASE_URL=https://api.kapso.ai
# KAPSO_API_VERSION=v24.0
# KAPSO_TIMEOUT=10
# KAPSO_TEMPLATE_LANGUAGE=es
# Optional: only for provisioning templates. Left empty, kapso:create-templates discovers it.
KAPSO_BUSINESS_ACCOUNT_ID=
# Generate with: php -r "echo bin2hex(random_bytes(32));" — then register the webhook with
# the SAME value via: php artisan kapso:register-webhook <public-url>
KAPSO_WEBHOOK_SECRET=
KAPSO_TEMPLATE_PROGRAM_CREATED=sav_program_created
KAPSO_TEMPLATE_PROGRAM_CANCELLED=sav_program_cancelled
KAPSO_TEMPLATE_PROGRAM_TASK_DUE=sav_program_task_due
